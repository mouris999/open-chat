# Copy to .env and fill in real values. Never commit the filled-in file.

# --- Postgres (t-auth-server) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tauth
DB_USER=postgres
DB_PASSWORD=your_actual_postgres_password

# --- Token signing (use 32+ random chars each) ---
ACCESS_TOKEN_SECRET=your_random_secret_key_here_32_chars_min
REFRESH_TOKEN_SECRET=another_random_secret_key_here_32_chars_min

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Android local.properties (NOT .env; see local.properties.example) ---
# cloudinary.apiSecret=...
# turn.username=...
# turn.credential=...
# api.baseUrl=http://10.0.2.2:3000/
